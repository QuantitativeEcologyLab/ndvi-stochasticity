data/water-shapefiles/World_Water_Bodies.lpk
data/water-shapefiles/water-shapefiles.qgz
data/wwf-ecoregions
data/avhrr-viirs-ndvi/group-level-datasets/*
!data/avhrr-viirs-ndvi/group-level-datasets/*-10-days*
